#!/usr/bin/env groovy

pipeline{
    agent any
    stages{
        
        stage ("Initialize"){
            parallel {
                stage("env"){
                    stages{
                        stage ("Prepare Properties"){
                            steps {
                                sh '''
                                    set +e
                                    mkdir JavaShark
                                    set -e
                                    cp $JENKINS_HOME/tools/properties.prop ./
                               '''
                            }
                        }
                    }
                }
                stage("info"){
                    stages{
                        stage ("Notify Papa"){
                            steps {
                                sh '''
                                    set +e
                                    curl -X POST -d '{
                                        "service": "JavaShark",
                                        "message": {
                                            "command": "newSoftwareVersion",
                                                "data": {
                                                    "reason": "Javashark build '${BUILD_ID}' is being built now. '${CHANGES_SINCE_LAST_SUCCESS, reverse=true, format="<b>Changes for Build #%n</b><br>%c<br>", changesFormat="<br>[%a] - (%r) %p<br> %m<br>"}'" ,
                                                    "comment": "'$CHANGE_TITLE'",
                                                    "debug": false
                                                },
                                            "timestamp": "'$(date +%s%M)'"
                                        }
                                    }' https://catsbot-201602.appspot.com/adam_api/secret_shark_path_shhhh/async
                                    set -e
                                '''
                            }
                        }
                    }
                }
            }
        }
        
        stage("Clean JavaShark"){
            steps{
                withMaven( maven: 'M3', jdk: 'JDK8U202', options: [artifactsPublisher(disabled: true)]) {
                    sh 'mvn -f "pom.xml" clean' 
                }
                sh "echo foo"
            }
        }
        stage("Build JavaShark"){
            steps{
                withMaven( maven: 'M3', jdk:'JDK8U202',  options: [artifactsPublisher(disabled: true)]) {
                    sh 'mvn -f "pom.xml" -Dmaven.test.skip=true -Dmaven.test.failure.ignore=true install' 
                }
                sh "echo foo"
            }
        }
        stage("Test JavaShark"){
            steps{
                withMaven( maven: 'M3', jdk:'JDK8U202',  options: [artifactsPublisher(disabled: true)]) {
                    sh "mvn -X -f 'pom.xml' validate test;"
                }
            }        
         
          
        }
        stage ("Upgrade"){
            parallel {
                stage('wrang-2'){
                   stages{
                        stage("Wrangler 2 Credentials"){
                            steps{
                                sh '/usr/bin/scp $JENKINS_HOME/tools/properties.prop jenkins@192.168.1.107:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 2 JavaShark"){
                            steps{
                                sh '/usr/bin/scp target/JavaShark-1.0-SNAPSHOT.jar jenkins@192.168.1.107:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 2 Launch"){
                            steps{
                                sh 'ssh jenkins@192.168.1.107 sudo /bin/systemctl restart javashark'
                            }
                        }
                    }
                    
                }
                stage('wrang-1'){
                    stages{
                        stage("Wrangler 1 Credentials"){
                            steps{
                                sh '/usr/bin/scp $JENKINS_HOME/tools/properties.prop javashark@192.168.1.115:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 1 JavaShark"){
                            steps{
                                sh '/usr/bin/scp target/JavaShark-1.0-SNAPSHOT.jar javashark@192.168.1.115:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 1 Launch"){
                            steps{
                                sh 'ssh javashark@192.168.1.115 sudo /bin/systemctl restart javashark'
                            }
                        }
                    }
                } 
                stage('notify'){
                    stages{
                        stage("Upgrade Notice"){
                            steps{
                                sh '''
                                    curl -X POST -d '{
                                        "service": "JavaShark", 
                                        "message": {
                                            "command": "newSoftwareVersion",
                                            "data": {
                                                "reason": "Javashark build '${BUILD_ID}' is coming online now." ,
                                                "comment": "'$CHANGE_TITLE'",
                                                "debug": false
                                            },
                                            "timestamp": "'$(date +%s%M)'"
                                        }
                                    }' https://catsbot-201602.appspot.com/adam_api/secret_shark_path_shhhh/async
                                '''
                            }
                        }
                    }
                    
                }
               
            }
        }
       
    }
    
    
}