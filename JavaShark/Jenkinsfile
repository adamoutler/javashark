#! /usr/bin/env groovy
pipeline {
    agent {
        docker{
            label "192.168.1.115"
            args '-u 0'
            image 'adamoutler/ubuntu11tessmaven:2'
            reuseNode true
        }
    }
    stages{
        stage('Preparation') { // for display purposes
            // Get some code from a GitHub repository
            parallel { 
                stage("ssh"){
                    stages{
                        stage("Establish Credentials"){
                            steps {
                                withCredentials([sshUserPrivateKey(credentialsId: 'javasharkOn192.168.1.115', keyFileVariable: 'credential', usernameVariable: 'user')]) {
                                    sh '''
                                        mkdir -p ~/.ssh/;
                                        ssh-keyscan 192.168.1.107>~/.ssh/known_hosts;
                                        ssh-keyscan 192.168.1.115>>~/.ssh/known_hosts;
                                        cp "${credential}" ~/.ssh/id_rsa;
                                        chmod -R 600 ~/.ssh
                                    '''
                                    sh '/usr/bin/scp ~/tools/properties.prop javashark@192.168.1.107:/opt/JavaShark/'

                                }
                            }
                        }
                    }
                }
                stage ("git"){

                    stages{
                        stage("git clone"){
                            steps{
                                git credentialsId:'GITEA-LOGIN-JAVASHARK', url:"https://git.adamoutler.com/adamoutler/javashark.git"
                            }
                        }
                    }
                }
                stage ("secret"){
                    stages{
                         stage ("Secret Properties"){
                            steps {
                                configFileProvider([configFile(fileId: '8b8ab138-7359-4307-83a4-f6744df56fcc', variable: 'CONFIG')]) {
                                    sh '''
                                        cp "$CONFIG" JavaShark/properties.prop
                                        cp "$CONFIG" ./properties.prop
                                        mkdir -p ~/tools/
                                        cp "$CONFIG" ~/tools/properties.prop
                                    '''
                                }
                            }
                        }
                    }
                }
                stage ("deps"){
                    stages{
                        stage("download tessdata"){
                            steps{
                                //Download tessdata.tar.gz and extract to userhome/tessdata/.
                                sh '''
                                    curl --output ~/tessdata.tar.gz https://baby-sharks.hackedyour.info/tesseract/tessdata.tar.gz
                                    tar -xzvf ~/tessdata.tar.gz -C ~/
                                '''            
                            }
                        }
                    }
                }
            stage("info"){
                    stages{
                        stage ("Notify Papa"){
                            steps {
                                sh '''
                                    set +e
                                    curl -X POST -d '{
                                        "service": "JavaShark",
                                        "message": {
                                            "command": "dockerBuild",
                                                "data": {
                                                    "reason": "Javashark build '${BUILD_ID}' is being built in a docker environment. '${CHANGES_SINCE_LAST_SUCCESS, reverse=true, format="<b>Changes for Build #%n</b><br>%c<br>", changesFormat="<br>[%a] - (%r) %p<br> %m<br>"}'" ,
                                                    "comment": "'$CHANGE_TITLE'",
                                                    "debug": false
                                                },
                                            "timestamp": "'$(date +%s%M)'"
                                        }
                                    }' https://catsbot-201602.appspot.com/adam_api/secret_shark_path_shhhh/async
                                    set -e
                                '''
                            }
                        }
                    }
                }
            }
        }   
        stage("Clean JavaShark"){
            steps{
                withMaven( maven: 'M3', jdk: 'OpenJDK-17.0.1', options: [artifactsPublisher(disabled: true)]) {
                    sh 'PATH="$MVN_CMD_DIR":$PATH && mvn -f "JavaShark/pom.xml" clean' 
                }
            }
        }
         stage("Build JavaShark"){
            steps{
                withMaven( maven: 'M3', jdk:'OpenJDK-17.0.1',  options: [artifactsPublisher(disabled: true)]) {
                    sh 'mvn -f "JavaShark/pom.xml" -Dmaven.test.skip=true -Dmaven.test.failure.ignore=true install' 
                }
            }
        }
        stage("Test JavaShark"){
            steps{
                withMaven( maven: 'M3', jdk:'OpenJDK-17.0.1',  options: [artifactsPublisher(disabled: true)]) {
                    sh "mvn -X -f 'JavaShark/pom.xml' validate test;"
                }
            }        
        }

        stage ("Upgrade"){
            parallel {
                stage('wrang-2'){
                   stages{
                        stage("Wrangler 2 Credentials"){
                            steps{
                                sh '/usr/bin/scp ~/tools/properties.prop javashark@192.168.1.107:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 2 JavaShark"){
                            steps{
                                sh '/usr/bin/scp JavaShark/target/JavaShark-1.0-SNAPSHOT.jar javashark@192.168.1.107:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 2 Launch"){
                            steps{
                                sh 'ssh javashark@192.168.1.107 sudo /bin/systemctl restart javashark'
                            }
                        }
                    }
                    
                }
                stage('wrang-1'){
                    stages{
                        stage("Wrangler 1 Credentials"){
                            steps{
                                sh '/usr/bin/scp ~/tools/properties.prop javashark@192.168.1.115:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 1 JavaShark"){
                            steps{
                                sh '/usr/bin/scp JavaShark/target/JavaShark-1.0-SNAPSHOT.jar javashark@192.168.1.115:/opt/JavaShark/'
                            }
                        }
                        stage("Wrangler 1 Launch"){
                            steps{
                                sh 'ssh javashark@192.168.1.115 sudo /bin/systemctl restart javashark'
                            }
                        }
                    }
                } 
            }
        }
        stage("Upgrade Notice"){
            steps{
                script {
                    def changes = " "
                    build = currentBuild
                    while(build != null && build.result != 'SUCCESS') {
                        for (changeLog in build.changeSets) {
                            for(entry in changeLog.items) {
                                changes+=entry.getMsg()+" --"+entry.getAuthor().getFullName()+"\n"
                            }
                        }
                        build = build.previousBuild
                    }
                    def safeChanges=changes.replaceAll("[^a-zA-Z-.,()!]+","")
                    sh """
                        RELEASE_NOTES="${changes}";
                        curl -X POST -d '{
                            "service": "JavaShark", 
                            "message": {
                                "command": "SoftwareUpdate",
                                "data": {
                                    "reason": "JavaShark build $BUILD_ID is now online.",
                                    "comment": "'"\$RELEASE_NOTES"'",
                                    "debug": false
                                },
                                "timestamp": "'\$(date +%s%M)'"
                            }
                        }' https://catsbot-201602.appspot.com/adam_api/secret_shark_path_shhhhh/async
                    """
                }
            }
        }
    }
}
